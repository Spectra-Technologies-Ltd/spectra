# Canonical origin of this landing site. Used for canonical URLs, OpenGraph,
# sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://spectratech.cc

# Base URL of the Spectra operations app (the Workplace login page).
NEXT_PUBLIC_APP_URL=https://spectra-lime.vercel.app

# Optional public social profiles. Links are hidden in the footer when unset.
# NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/your-company
# NEXT_PUBLIC_X_URL=https://x.com/your-handle
# NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/your-handle

# Optional public contact details. The phone row is hidden when unset.
NEXT_PUBLIC_CONTACT_EMAIL=hello@spectra.tech
# NEXT_PUBLIC_CONTACT_PHONE=+234 000 000 0000
NEXT_PUBLIC_CONTACT_LOCATION=Remote / Global

# Server-side destination for form submissions. Point this at any endpoint that
# accepts a JSON POST (Zapier/Make/n8n catch hook, Formspree, Slack workflow, or
# your own API). Per-form overrides: NEWSLETTER_WEBHOOK_URL, CONTACT_WEBHOOK_URL,
# DEMO_WEBHOOK_URL. When unset, submissions are accepted and logged server-side.
# SUBMISSIONS_WEBHOOK_URL=https://hooks.example.com/spectra-leads
